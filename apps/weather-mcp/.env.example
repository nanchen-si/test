# The default fixture keeps local browser E2E tests deterministic.
WEATHER_MCP_DATA_SOURCE=fixture

# To use QWeather, set WEATHER_MCP_DATA_SOURCE=qweather and provide the
# dedicated API host plus the Ed25519 JWT credential values.
# QWEATHER_API_HOST=https://your-api-host.qweatherapi.com
# QWEATHER_KEY_ID=your-credential-id
# QWEATHER_DEVELOPER_ID=your-developer-id
# QWEATHER_PROJECT_ID=your-project-id
# QWEATHER_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
