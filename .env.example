# 本地天气助手配置
# 默认使用本地模拟天气；接入和风天气后改为 qweather。
WEATHER_MCP_DATA_SOURCE=fixture
WEATHER_MCP_HOST=127.0.0.1
WEATHER_MCP_PORT=3101
WEATHER_MCP_URL=http://127.0.0.1:3101/mcp

# 可选：填写后启用 DeepSeek 生成式回答；留空也可以运行。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 和风天气配置：填写完整后，将 WEATHER_MCP_DATA_SOURCE 改为 qweather。
QWEATHER_API_HOST=
QWEATHER_API_KEY=
